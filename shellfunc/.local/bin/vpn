#!/usr/bin/env bash

# Keep credentials out of shell traces, including when invoked with bash -x.
set +x
set -o pipefail
export -n password

if ! password="$(pass mks/services/vpn/vpn | tr -d '\n')" || [[ -z "$password" ]]; then
    echo "Cannot find system in pass, add it" >&2
    exit 1
fi

if ! username="$(pass mks/services/vpn/vpn-user | tr -d '\n')" || [[ -z "$username" ]]; then
    echo "Cannot find VPN username in pass, add it" >&2
    exit 1
fi

if ! url="$(pass mks/services/vpn/vpn-url | tr -d '\n')" || [[ -z "$url" ]]; then
    echo "Cannot find VPN URL in pass, add it" >&2
    exit 1
fi

logpath="$HOME/Downloads/mksvpnlog.txt"

starttime=$(date)
echo "Start time is $starttime" | tee -a "$logpath"

# Bash's builtin printf keeps the password out of every process's arguments.
printf '%s\n' "$password" | sudo "$(command -v openconnect)" \
    --usergroup=portal --protocol=gp --user="$username" --passwd-on-stdin "$url" | ts
status=$?

endtime=$(date)

echo "Start time is $starttime"
echo "end time is $endtime" | tee -a "$logpath"
exit "$status"
